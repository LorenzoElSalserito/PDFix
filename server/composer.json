{
  "name": "pdfix/server",
  "description": "PDFix - PDF Merge & PDF/A Converter backend",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=7.4",
    "tecnickcom/tcpdf": "^6.7",
    "setasign/fpdi": "^2.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "PDFix\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PDFix\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "serve": "php -S localhost:8080 -t public"
  }
}
