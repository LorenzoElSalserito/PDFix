# Dipendenze
node_modules/

# Output di build e artefatti di release
# Le icone generate restano versionate: servono al README e alla guardia
# verify:packaging anche prima di rigenerarle.
dist/
release/

# Test
test-results/
playwright-report/
blob-report/
coverage/

# Stato locale della pipeline di release
scripts/.release-pending.json

# Pianificazione interna, non fa parte della distribuzione
PLAN.md

# IDE ed editor
# Le configurazioni di avvio restano versionate: sono i pulsanti di esecuzione
# del progetto (avvio, build, test), il resto di .idea/ e' stato locale.
.idea/*
!.idea/runConfigurations/
*.iml
*.iws
.vscode/
*.swp

# Sistema operativo
.DS_Store
Thumbs.db
*~

# Ambiente
.env
.env.local
.env.*.local

# Log e temporanei
*.log
npm-debug.log*
*.tmp
.cache/

# Claude Code
.claude/
